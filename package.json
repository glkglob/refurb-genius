{
  "name": "tanstack_start_ts",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:vercel": "NODE_OPTIONS=--max-old-space-size=4096 vite build --config vite.vercel.config.ts",
    "build:ios": "vite build --config vite.ios.config.ts",
    "prepare:ios": "node scripts/prepare-ios-native-bundle.mjs",
    "ios:verify-copied": "node scripts/prepare-ios-native-bundle.mjs --verify-copied",
    "ios:verify-app-bundle": "node scripts/prepare-ios-native-bundle.mjs --verify-app-bundle",
    "test:ios-provenance": "node --test scripts/lib/ios-build-provenance.test.mjs scripts/prepare-ios-native-bundle.test.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "catalogue:dry-run": "tsx scripts/catalogue-dry-run.ts",
    "catalogue:persist": "tsx scripts/catalogue-persist.ts",
    "test:invariants": "TSX_TSCONFIG_PATH=./tsconfig.json tsx --test tests/invariants/*.test.ts",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "prepare": "node scripts/install-git-hooks.mjs",
    "security:secrets": "gitleaks detect --source . --config gitleaks.toml --redact",
    "security:secrets:staged": "gitleaks protect --staged --config gitleaks.toml --redact",
    "security:audit": "pnpm audit --audit-level=high",
    "security:boundary": "TSX_TSCONFIG_PATH=./tsconfig.json tsx --test tests/invariants/auth-env.invariant.test.ts tests/invariants/server-only-boundary.invariant.test.ts",
    "verify:4c2b-types": "node scripts/verify-4c2b-database-types.mjs",
    "verify:4c2b-types:generate": "node scripts/verify-4c2b-database-types.mjs --require-generate",
    "verify:4c2c-types": "node scripts/verify-4c2c-database-types.mjs",
    "verify:4c2c-types:generate": "node scripts/verify-4c2c-database-types.mjs --require-generate",
    "verify:database-types:compatibility": "node scripts/verify-database-types-compatibility.mjs",
    "verify:database-types:compatibility:test": "node --test scripts/verify-database-types-compatibility.test.mjs",
    "verify:database-types:canonical": "node scripts/verify-database-types-canonical.mjs",
    "verify:database-types:canonical:test": "node --test scripts/verify-database-types-canonical.test.mjs",
    "supabase:status": "supabase status",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test:db": "supabase test db",
    "supabase:types": "SUPABASE_DB_PASSWORD=postgres supabase gen types typescript --local --schema public",
    "supabase:types:canonical": "bash -c 'set -euo pipefail; SUPABASE_DB_PASSWORD=postgres pnpm exec supabase gen types typescript --local --schema public > packages/supabase/src/database.types.ts; pnpm exec prettier --write --config .prettierrc packages/supabase/src/database.types.ts'",
    "supabase:lint": "supabase db lint",
    "verify:b2d:persistence-concurrency": "node scripts/verify-b2d-persistence-concurrency.mjs",
    "verify:b2d:persistence-concurrency:test": "node --test scripts/verify-b2d-persistence-concurrency.test.mjs",
    "verify:b2e:lifecycle-concurrency": "node scripts/verify-b2e-lifecycle-concurrency.mjs",
    "verify:b2e:lifecycle-concurrency:test": "node --test scripts/verify-b2e-lifecycle-concurrency.test.mjs"
  },
